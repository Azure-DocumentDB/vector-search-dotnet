# Example environment overrides for this sample. Copy to .env and fill in.
# Placeholder values only. Never commit a real .env (it is git-ignored).
#
# This is a .NET sample: configuration is read from appsettings.json and then
# overridden by process environment variables via .AddEnvironmentVariables().
# Section nesting uses a DOUBLE UNDERSCORE separator, not a colon or a dot.
#
# .NET does NOT auto-load .env files. Export these into the process first, e.g.
#   PowerShell:  Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim()) } }
#   bash/zsh:    set -a; source .env; set +a
# Alternatively set the same variables directly in your shell and skip .env.

AzureOpenAI__TenantId=<your-tenant-id>
AzureOpenAI__Endpoint=https://<your-openai-service-name>.openai.azure.com/
AzureOpenAI__EmbeddingModel=text-embedding-3-small
AzureOpenAI__ApiVersion=2023-05-15

MongoDB__TenantId=<your-tenant-id>
MongoDB__ClusterName=<your-cluster-name>
MongoDB__LoadBatchSize=100

VectorSearch__DatabaseName=Hotels
VectorSearch__TopK=5
VectorSearch__Query=quintessential lodging near running trails, eateries, retail

Embedding__FieldToEmbed=Description
Embedding__EmbeddedField=DescriptionVector
Embedding__Dimensions=1536
Embedding__BatchSize=16

DataFiles__WithoutVectors=data/Hotels.json
DataFiles__WithVectors=data/Hotels_Vector.json
