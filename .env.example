# Process environment only; .NET does NOT automatically load .env or appsettings.json.
# Copy to .env (ignored), fill locally, then export; never commit credentials.
# No default database/prefix: select an explicitly approved disposable namespace.
MONGO_URI=
MONGO_ALLOWED_HOST=
MONGO_DATABASE=
MONGO_COLLECTION_PREFIX=
MONGO_AUTH_MODE=scram
MONGO_USERNAME=
MONGO_PASSWORD=
ALLOW_DATABASE_WRITES=false
VECTOR_DATA_FILE=data/Hotels_Vector.json
QUERY_VECTOR_FILE=data/query-vector.json
OPERATION_TIMEOUT_SECONDS=300

# Optional BILLABLE model path, never used by fixture searches.
ALLOW_MODEL_CALLS=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_ALLOWED_HOST=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
QUERY_TEXT=
